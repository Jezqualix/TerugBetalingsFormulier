PORT=3004

# MS SQL Server
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# Set to true only for local development with self-signed certificates
DB_TRUST_CERT=false

# SMTP (IP-authenticated — no credentials needed)
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
ADMIN_EMAIL=

# Admin dashboard
ADMIN_TOKEN=

# Security (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CSRF_SECRET=
COOKIE_SECRET=

# Storage
UPLOAD_DIR=./uploads
