PORT=3004

# DEV_MODE: local layout/dev only. When 'true' AND NODE_ENV is not 'production',
# the app runs with NO database, NO SMTP and NO auth: the admin dashboard is
# open and served with in-memory demo data. Hard-gated so it can never activate
# in Azure (NODE_ENV=production there). Leave empty for any real environment.
DEV_MODE=

# MS SQL Server (not needed when DEV_MODE=true)
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Schema holding submissions and uploads. Every query is qualified with it, so
# this one value decides which set of tables the app uses. Leave empty for dbo.
# Production runs tbf on DockxDB (vw-sql-2); see migrations/004.
DB_SCHEMA=

# Database encryption & certificate trust
# Lokaal (SQL Server/SQLEXPRESS): DB_ENCRYPT=false, DB_TRUST_CERT=true
# Azure SQL: DB_ENCRYPT=true, DB_TRUST_CERT=false
# vw-sql-2 over the VNet: DB_ENCRYPT=true, DB_TRUST_CERT=true -- encrypted, but
# the server presents a certificate no public CA signed.
DB_ENCRYPT=false
DB_TRUST_CERT=true

# SMTP — smtp2go (authenticated). STARTTLS on port 2525/587.
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=terugbetalingsformulier@dockx.be
ADMIN_EMAIL=dabi@dockx.be

# Admin-autorisatie
# ADMIN_ROLE: naam van de Entra app-rol die admin-toegang geeft (default: Admin).
ADMIN_ROLE=Admin
# ADMIN_TOKEN: local/dev admin access and break-glass (Authorization: Bearer <token>). In production, Easy Auth blocks non-Entra requests.
ADMIN_TOKEN=

# Security (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CSRF_SECRET=
COOKIE_SECRET=

# Storage — path where uploads land (mounted at /app/uploads in container)
UPLOAD_DIR=./uploads
