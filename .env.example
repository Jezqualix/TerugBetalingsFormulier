PORT=3004

# MS SQL Server
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Database encryption & certificate trust
# Lokaal (SQL Server/SQLEXPRESS): DB_ENCRYPT=false, DB_TRUST_CERT=true
# Azure SQL: DB_ENCRYPT=true, DB_TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# SMTP — smtp2go (authenticated). STARTTLS on port 2525/587.
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=terugbetalingsformulier@dockx.be
ADMIN_EMAIL=dabi@dockx.be

# Admin dashboard
ADMIN_TOKEN=

# Security (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CSRF_SECRET=
COOKIE_SECRET=

# Storage — path where uploads land (mounted at /app/uploads in container)
UPLOAD_DIR=./uploads
